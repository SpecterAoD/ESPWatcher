[Unit]
Description=ESPWatcher Status-JSON (nur lesend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=espwatcher
Group=espwatcher
# Fuer "vcgencmd get_throttled" (Unterspannung/Drosselung)
SupplementaryGroups=video
ExecStart=/usr/bin/python3 -I /usr/local/bin/espwatcher-status.py

Environment=ESPW_BIND=192.168.2.6
Environment=ESPW_PORT=8092
Environment=ESPW_VIP=192.168.2.10
Environment=ESPW_PIZERO=192.168.2.5
Environment=ESPW_DISK_PATH=/mnt/data
# Optional: Datei, die nach jedem erfolgreichen Backup aktualisiert wird
#Environment=ESPW_BACKUP_MARKER=/mnt/data/backup/.last-success

Restart=always
RestartSec=5

# Haertung: der Dienst darf nichts veraendern
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_NETLINK braucht 'ip addr' (wer haelt die keepalived-Adresse?), AF_UNIX der systemd-Zugriff
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
MemoryMax=64M

[Install]
WantedBy=multi-user.target
